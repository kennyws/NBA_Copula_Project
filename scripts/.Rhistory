data <- full_data %>%
filter(athlete_display_name == player_name) %>%
arrange(game_date)
if (nrow(data) < 20) {
stop("Not enough games (", nrow(data), ") for a stable vine fit")
}
stat_cols <- data %>%
dplyr::select(points, assists, rebounds,
three_point_field_goals_made, player_possessions)
# Column order as fit -- RVineSim output follows THIS order
var_cols <- setNames(seq_along(stat_cols), colnames(stat_cols))
if (!(var_x %in% names(var_cols)) || !(var_y %in% names(var_cols))) {
stop("var_x/var_y must be one of: ", paste(names(var_cols), collapse = ", "))
}
vars <- colnames(stat_cols)
poss_idx <- which(vars == "player_possessions")
order <- c(poss_idx, setdiff(seq_along(vars), poss_idx))
d <- length(vars)
npairs <- d * (d - 1) / 2
skeleton <- C2RVine(
order,
family = rep(0, npairs),
par = rep(0, npairs),
par2 = rep(0, npairs)
)
u <- pobs(as.matrix(stat_cols))
vine_fit <- RVineCopSelect(
u,
familyset = NA,
Matrix = skeleton$Matrix,
indeptest = TRUE
)
sim <- RVineSim(n_sim, vine_fit)
# Map simulated uniforms back to original scale via empirical quantiles,
# using each variable's OWN column (not points/assists/rebounds specifically)
x_col <- var_cols[[var_x]]
y_col <- var_cols[[var_y]]
sim_x <- quantile(stat_cols[[var_x]], sim[, x_col], type = 7)
sim_y <- quantile(stat_cols[[var_y]], sim[, y_col], type = 7)
plot_data <- bind_rows(
tibble(!!var_x := stat_cols[[var_x]], !!var_y := stat_cols[[var_y]], source = "Actual"),
tibble(!!var_x := sim_x, !!var_y := sim_y, source = "Vine (simulated)")
)
ggplot(plot_data, aes(x = .data[[var_x]], y = .data[[var_y]])) +
stat_density_2d(
data = filter(plot_data, source == "Vine (simulated)"),
aes(fill = after_stat(density)),
geom = "raster", contour = FALSE,
n = 200,
h = c(MASS::bandwidth.nrd(plot_data[[var_x]]), MASS::bandwidth.nrd(plot_data[[var_y]])) * 1.5,  # wider bandwidth
xlim = c(min(plot_data[[var_x]]) - 10, max(plot_data[[var_x]]) + 10),
ylim = c(min(plot_data[[var_y]]) - 10, max(plot_data[[var_y]]) + 10)
) +
scale_fill_gradient(low = "mistyrose", high = "firebrick") +
geom_point(
data = filter(plot_data, source == "Actual"),
color = "black", alpha = 0.8, size = 2
) +
labs(
title = paste0(player_name, ": ", var_x, " vs ", var_y),
subtitle = "Actual games (points) vs fitted 5D R-vine (shaded density)",
x = var_x, y = var_y, fill = "Vine density"
) +
theme_minimal()
}

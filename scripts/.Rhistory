stat_density_2d(
data = filter(plot_data, source == "Vine (simulated)"),
aes(fill = after_stat(density)),
geom = "raster", contour = FALSE,
n = 200,
h = c(MASS::bandwidth.nrd(plot_data[[var_x]]), MASS::bandwidth.nrd(plot_data[[var_y]])) * 1.5,  # wider bandwidth
xlim = c(min(plot_data[[var_x]]) - 10, max(plot_data[[var_x]]) + 10),
ylim = c(min(plot_data[[var_y]]) - 10, max(plot_data[[var_y]]) + 10)
) +
scale_fill_gradient(low = "mistyrose", high = "firebrick") +
geom_point(
data = filter(plot_data, source == "Actual"),
color = "black", alpha = 0.8, size = 2
) +
labs(
title = paste0(player_name, ": ", var_x, " vs ", var_y),
subtitle = "Actual games (points) vs fitted 5D R-vine (shaded density)",
x = var_x, y = var_y, fill = "Vine density"
) +
theme_minimal()
